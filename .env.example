# Google reCAPTCHA v3 Keys
# Get your keys from: https://www.google.com/recaptcha/admin
# Site key is used in the frontend
REACT_APP_RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here

# Secret key is used in the backend (serverless function)
# DO NOT commit this to git - use Vercel environment variables in production
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key_here

# Neon Database URL
# Get this from your Neon project dashboard
# Example: postgresql://user:password@host.neon.tech/dbname?sslmode=require
DATABASE_URL=your_neon_database_url_here
